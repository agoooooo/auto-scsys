# Private staging only. Bind to 127.0.0.1 unless testing from a trusted LAN device.
FLOWPILOT_STAGING_BIND_ADDRESS=127.0.0.1
FLOWPILOT_STAGING_WEB_PORT=18000
FLOWPILOT_STAGING_API_PORT=18001
FLOWPILOT_STAGING_S3_PORT=19000
FLOWPILOT_STAGING_WEB_ORIGIN=http://127.0.0.1:18000
FLOWPILOT_STAGING_S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000

FLOWPILOT_POSTGRES_DB=flowpilot_staging
FLOWPILOT_POSTGRES_USER=flowpilot_staging
FLOWPILOT_POSTGRES_PASSWORD=replace-with-a-random-staging-only-password
FLOWPILOT_DATABASE_URL=postgresql://flowpilot_staging:replace-with-a-random-staging-only-password@db:5432/flowpilot_staging
FLOWPILOT_TOKEN_SECRET=replace-with-at-least-32-random-staging-only-bytes

FLOWPILOT_S3_BUCKET=flowpilot-staging
FLOWPILOT_S3_REGION=us-east-1
FLOWPILOT_S3_ACCESS_KEY=replace-with-a-staging-only-access-key
FLOWPILOT_S3_SECRET_KEY=replace-with-a-random-staging-only-object-store-secret
