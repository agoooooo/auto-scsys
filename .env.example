FLOWPILOT_API_DOMAIN=api.example.com
FLOWPILOT_WEB_DOMAIN=console.example.com
FLOWPILOT_S3_DOMAIN=objects.example.com
FLOWPILOT_POSTGRES_DB=flowpilot
FLOWPILOT_POSTGRES_USER=flowpilot
FLOWPILOT_POSTGRES_PASSWORD=replace-with-a-long-URI-safe-random-password
FLOWPILOT_DATABASE_URL=postgresql://flowpilot:replace-with-a-long-URI-safe-random-password@db:5432/flowpilot
FLOWPILOT_TOKEN_SECRET=replace-with-at-least-32-random-characters
FLOWPILOT_S3_BUCKET=flowpilot-scripts
FLOWPILOT_S3_REGION=us-east-1
FLOWPILOT_S3_ACCESS_KEY=replace-with-a-random-access-key
FLOWPILOT_S3_SECRET_KEY=replace-with-a-long-random-secret-key

# Optional account recovery mail. Leave all blank to keep password recovery disabled.
FLOWPILOT_SMTP_HOST=
FLOWPILOT_SMTP_PORT=587
FLOWPILOT_SMTP_USERNAME=
FLOWPILOT_SMTP_PASSWORD=
FLOWPILOT_SMTP_FROM=
FLOWPILOT_SMTP_USE_SSL=false
