{$FLOWPILOT_API_DOMAIN} {
    reverse_proxy api:8001
}

{$FLOWPILOT_WEB_DOMAIN} {
    handle_path /api/* {
        reverse_proxy api:8001
    }

    handle {
        reverse_proxy web:80
    }
}

{$FLOWPILOT_S3_DOMAIN} {
    reverse_proxy minio:9000 {
        header_up Host {http.request.host}
    }
}
